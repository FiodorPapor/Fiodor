# Property Intent Core, one instance per agency/tenant.
POSTGRES_DB=property_intent
POSTGRES_USER=intent
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://intent:change-me@db:5432/property_intent

SERVICE_KEY=change-me
HOST_PORT=8050
CONTAINER_PREFIX=property-intent
SHARED_NETWORK=agency-shared

TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_BOT_USERNAME=AgencyCatalogBot
MINIAPP_URL=https://catalog.example.com
MARKETPLACE_ENABLED=0
TELEGRAM_WEBHOOK_SECRET=
DEEPL_API_KEY=
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
MENU_BUTTON_URL=https://catalog.example.com/?v=release-id
MENU_BUTTON_TEXT=Каталог
OPERATOR_CHAT_ID=
OPERATOR_BOT_TOKEN=
OPERATOR_SLA_MINUTES=30
OPERATOR_CRM_URL=https://app.example.com/telegram-crm
OPERATOR_CRM_TAB=
SMOKE_USERNAME=property_network_smoke

GROWTH_CORE_URL=http://growth-core-api:8080
GROWTH_CORE_KEY=change-me
GROWTH_TENANT=agency_slug

BRAND_NAME=Agency Name
BRAND_TAGLINE=Real estate catalog
BRAND_LOGO_URL=/brand-logo.jpg
PUBLIC_LANGUAGE_DEFAULT=es
TELEGRAM_CHANNEL_URL=
ATTRIBUTION_CAMPAIGN=agency_catalog
SOURCE_LABEL=agency_original
CRM_SOURCE=agency_miniapp
CRM_SAVED_SEARCH_TYPE=property_saved_search

# Use either a native CRM adapter or the portable signed webhook.
CRM_BASE_URL=
CRM_API_KEY=
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Host directories implementing the normalized catalog/state contracts.
CATALOG_HOST_PATH=/opt/agency/catalog
STATE_HOST_PATH=/opt/agency/state

CATALOG_PATH=/data/catalog/catalog.json
CATALOG_ALIAS_PATH=/data/catalog/catalog-aliases.json
QUALITY_PATH=/data/state/quality.json
GEO_ENRICHMENT_PATH=/data/state/geo-enrichment.json
RU_TRANSLATIONS_PATH=/data/state/ru-full-translations.json
EN_TRANSLATIONS_PATH=/data/state/en-content.json
INIT_DATA_MAX_AGE_SECONDS=86400
TEST_TELEGRAM_IDS=
INTERNAL_TELEGRAM_IDS=

# First-party browser Agent Inbox. Keep the access code outside Git/.env.
# Deploy reads it from /root/.agent-inbox-access by default; it is never copied into Git/runtime .env.
AGENT_SESSION_HOURS=12

# Neutral inventory source registry; contains no credentials.
SOURCE_REGISTRY_PATH=/data/source-registry.json
SOURCE_REGISTRY_HOST_PATH=/opt/agency/source-registry.json
