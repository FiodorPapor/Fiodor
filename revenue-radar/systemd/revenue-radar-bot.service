[Unit]
Description=Revenue Radar Telegram Bot
After=network-online.target revenue-radar-broad.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/intent-radar
EnvironmentFile=/opt/intent-radar/radar-alert.env
ExecStart=/usr/bin/python3 /opt/intent-radar/radar_bot.py
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
