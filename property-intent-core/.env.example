# Property Intent Core, one instance per agency/tenant.
POSTGRES_DB=property_intent
POSTGRES_USER=intent
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://intent:change-me@db:5432/property_intent

SERVICE_KEY=change-me
HOST_PORT=8050
CONTAINER_PREFIX=property-intent
SHARED_NETWORK=agency-shared

TELEGRAM_BOT_TOKEN=change-me
TELEGRAM_BOT_USERNAME=AgencyCatalogBot
MINIAPP_URL=https://catalog.example.com
MENU_BUTTON_URL=https://catalog.example.com/?v=release-id
MENU_BUTTON_TEXT=Каталог
OPERATOR_CHAT_ID=

GROWTH_CORE_URL=http://growth-core-api:8080
GROWTH_CORE_KEY=change-me
GROWTH_TENANT=agency_slug

BRAND_NAME=Agency Name
CRM_SOURCE=agency_miniapp
CRM_SAVED_SEARCH_TYPE=property_saved_search

# Use either a native CRM adapter or the portable signed webhook.
CRM_BASE_URL=
CRM_API_KEY=
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# Host files implementing the normalized catalog contract.
CATALOG_HOST_PATH=/opt/agency/catalog.json
QUALITY_HOST_PATH=/opt/agency/quality.json
GEO_HOST_PATH=/opt/agency/geo-enrichment.json

CATALOG_PATH=/data/catalog.json
QUALITY_PATH=/data/quality.json
GEO_ENRICHMENT_PATH=/data/geo-enrichment.json
INIT_DATA_MAX_AGE_SECONDS=86400
TEST_TELEGRAM_IDS=
